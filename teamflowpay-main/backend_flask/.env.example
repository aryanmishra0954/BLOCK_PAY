# BlockPay Flask Backend Environment Variables

# Server Configuration
PORT=3000
FLASK_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# AI Provider Configuration (Groq Cloud API)
# Get your free key at: https://console.groq.com/keys
# Supported models: llama-3.1-8b-instant, openai/gpt-oss-120b, llama3-70b-8192
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Database Configuration
# Option A (PostgreSQL - Recommended for production / Docker):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/blockpay
# Option B (Leave empty or commented out for zero-config automatic SQLite fallback):
DATABASE_URL=
